{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quiet-atlas-console",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-08",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "routes": [{ "pattern": "admin.quietatlas.io", "custom_domain": true }],
  "vars": { "ENVIRONMENT": "production" },
  "secrets": { "required": ["ACCESS_TEAM_DOMAIN", "ACCESS_AUD", "OWNER_EMAIL"] },
  "services": [
    { "binding": "KINGS_API", "service": "kings-search-api" },
    { "binding": "DARTS_SIGNALING", "service": "darts-vs-squirts-signaling" }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 },
    "traces": { "enabled": false }
  },
  "env": {
    "local": {
      "name": "quiet-atlas-console-local",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      "services": [],
      "vars": {
        "ENVIRONMENT": "local", "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "", "OWNER_EMAIL": "local-owner"
      }
    }
  }
}
