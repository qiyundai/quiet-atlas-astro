{
  "name": "@quiet-atlas/console",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --env local --port 8810",
    "build": "astro build && node tools/build-csp.mjs",
    "types": "wrangler types --strict-vars false",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "validate": "npm run types && npm test && npm run check && wrangler deploy --dry-run --env=",
    "predeploy": "node tools/check-deploy.mjs",
    "deploy": "npm run validate && node tools/deploy.mjs"
  },
  "overrides": {
    "@astrojs/react": {
      "@vitejs/plugin-react": "6.1.1"
    }
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "astro": "7.3.8",
    "jose": "6.2.12",
    "oxc-transform-react": "0.145.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20261006.1-alpha",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "4.149.0"
  }
}
